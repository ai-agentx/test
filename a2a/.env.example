# A2A Test Environment Variables
# Copy this file to .env and customize as needed

# Server Configuration
A2A_HOST=localhost
A2A_PORT=8080

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Set to 1/true to force echo-only mode without LLM calls
NO_LLM=0

# Client request timeout in seconds
CLIENT_TIMEOUT=30.0

# -----------------------------
# LLM Configuration (OpenAI-compatible)
# -----------------------------
# Choose an OpenAI-compatible endpoint:
# - OpenAI: https://api.openai.com/v1
# - LiteLLM proxy: http://localhost:4000
# - Ollama (OpenAI-compatible): http://localhost:11434/v1
OPENAI_API_BASE=https://api.openai.com/v1

# Replace with your API key (or proxy key). Leave blank only if your proxy doesn't require it.
OPENAI_API_KEY=your_api_key

# Choose a model available at your provider/proxy
# Examples: gpt-4o-mini, gpt-3.5-turbo, llama3.1:8b, mistral-small
OPENAI_MODEL_NAME=gpt-4o-mini

# -----------------------------
# Optional additional providers
# -----------------------------
# ANTHROPIC_API_KEY=your_api_key
# GOOGLE_API_KEY=your_api_key
