# A2A Test Environment Variables
# Copy this file to .env and customize as needed

# Server Configuration
A2A_HOST=localhost
A2A_PORT=8080

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Client Configuration
CLIENT_TIMEOUT=30.0

# OpenAI/LLM Configuration
# Standard OpenAI
# OPENAI_API_KEY=your_openai_key_here

# Custom OpenAI-compatible API (e.g., LiteLLM, LocalAI, etc.)
# OPENAI_API_BASE=http://localhost:4000/v1
# OPENAI_MODEL_NAME=gpt-3.5-turbo

# LiteLLM Examples:
# For Anthropic via LiteLLM: OPENAI_API_BASE=http://localhost:4000/v1, OPENAI_MODEL_NAME=claude-3-sonnet-20240229
# For Azure OpenAI: OPENAI_API_BASE=https://your-resource.openai.azure.com/openai/deployments/your-deployment/v1
# For local models: OPENAI_API_BASE=http://localhost:1234/v1, OPENAI_MODEL_NAME=local-model

# Other API Keys
# ANTHROPIC_API_KEY=your_anthropic_key_here
# GOOGLE_API_KEY=your_google_key_here
